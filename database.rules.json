          },
          "table": {
            ".validate": "newData.hasChildren(['pointsForMatchWin', 'pointsForDraw', 'pointsForMatchLoss'])",
            "pointsForMatchWin": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 == 0"
            },
            "pointsForDraw": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 == 0"
            },
            "pointsForMatchLoss": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 == 0"
            },
            "$other": { ".validate": false }
          },
          "overall": {
            ".validate": "newData.hasChildren(['matchWinBonus', 'pointsPerRoundWon', 'participationPoints', 'qualificationBonus', 'competitionWinnerBonus', 'runnerUpBonus', 'thirdPlaceBonus'])",
            "matchWinBonus": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 == 0"
            },
            "pointsPerRoundWon": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 == 0"
            },
            "participationPoints": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 == 0"
            },
            "qualificationBonus": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 == 0"
            },
            "competitionWinnerBonus": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 == 0"
            },
            "runnerUpBonus": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 == 0"
            },
            "thirdPlaceBonus": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 == 0"
            },
            "$other": { ".validate": false }
          },
          "winnerBonus": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 == 0"
          },
          "participationPoints": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 == 0"
          },
          "placementPoints": {
            ".validate": "!newData.child('32').exists()",
            "$index": {
              ".validate": "$index.matches(/^(0|[1-9]|[12][0-9]|3[01])$/) && newData.hasChildren(['place', 'points'])",
              "place": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 32 && newData.val() % 1 == 0"
              },
              "points": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 == 0"
              },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        },
        "displayOrder": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && newData.val() % 1 == 0"
        },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000 && (!data.exists() || newData.val() >= data.val())"
        },
        "createdByUid": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "updatedByUid": { ".validate": "newData.val() == auth.uid" },
        "revision": {
          ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() % 1 == 0"
        },
        "schemaVersion": { ".validate": "newData.val() == 1" },
        "status": {
          ".validate": "newData.val() == 'scheduled' || newData.val() == 'archived'"
        },
        "publishedAt": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() <= now && newData.val() > now - 60000) || (data.exists() && newData.val() == data.val()))"
        },
        "publishedByUid": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "$other": { ".validate": false }
      }
    },
    "audit": {
      ".read": "auth != null && auth.token.admin === true",
      "$auditId": {
        ".write": "auth != null && auth.token.admin === true && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['id', 'action', 'entityType', 'entityId', 'actorUid', 'occurredAt', 'summary', 'schemaVersion']) && newData.child('id').val() == $auditId",
        "id": {
          ".validate": "newData.isString() && newData.val() == $auditId"
        },
        "action": {
          ".validate": "newData.isString() && newData.val().matches(/^(draft-created|draft-updated|draft-deleted|draft-duplicated|competition-published|competition-updated|competition-archived|competition-restored|competition-reordered)$/)"
        },
        "entityType": { ".validate": "newData.val() == 'competition'" },
        "entityId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "actorUid": { ".validate": "newData.val() == auth.uid" },
        "beforeRevision": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 == 0"
        },
        "afterRevision": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 == 0"
        },
        "occurredAt": {
          ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000"
        },
        "summary": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 160"
        },
        "schemaVersion": { ".validate": "newData.val() == 1" },
        "$other": { ".validate": false }
      }
    }
  }
}
