{
  "name": "games-and-castles",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \".github/**/*.yml\" \"*.{json,ts,md,mjs}\" \"index.html\" \"eslint.config.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \".github/**/*.yml\" \"*.{json,ts,md,mjs}\" \"index.html\" \"eslint.config.js\"",
    "precommit": "lint-staged",
    "prepare": "husky",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-games-and-castles --only database \"vitest run --config vitest.rules.config.ts\"",
    "test:ops:reset-emulator": "firebase emulators:exec --project demo-games-and-castles --only auth,database \"vitest run --config vitest.ops.config.ts\"",
    "security:scan": "node scripts/security-scan.mjs",
    "security:audit": "npm audit --omit=dev && npm run security:scan",
    "security:check": "npm run security:audit",
    "emulators": "firebase emulators:start --project demo-games-and-castles --only auth,database,ui",
    "deploy:rules": "firebase deploy --only database --project",
    "reveal:admin-local": "node scripts/reveal-admin-local.mjs",
    "admin:set-claim": "node scripts/set-admin-claim.mjs",
    "backup:create": "node scripts/backup-database.mjs",
    "backup:inspect": "node scripts/inspect-backup.mjs",
    "backup:restore-dev": "node scripts/restore-dev-backup.mjs",
    "privacy:cleanup": "node scripts/cleanup-private-data.mjs",
    "ops:reset-project": "node scripts/reset-project.mjs"
  },
  "dependencies": {
    "framer-motion": "12.42.2",
    "firebase": "12.16.0",
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "5.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "firebase-admin": "14.2.0",
    "firebase-tools": "15.25.0",
    "globals": "17.8.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.2.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
